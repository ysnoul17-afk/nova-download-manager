{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nova Download Manager",
  "version": "0.1.0",
  "identifier": "app.novadownloadmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nova Download Manager",
        "width": 1240,
        "height": 780,
        "minWidth": 920,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Nova Download Manager",
    "category": "Utility",
    "shortDescription": "Gestionnaire de téléchargements",
    "longDescription": "Nova Download Manager accélère, organise et reprend vos téléchargements.",
    "copyright": "© 2026 Nova Download Manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["French", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  }
}
