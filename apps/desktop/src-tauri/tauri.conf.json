{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nova Download Manager",
  "version": "0.4.0",
  "identifier": "app.novadownloadmanager.desktop",
  "build": {
    "beforeDevCommand": "node ../../scripts/prepare-sidecar.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../../scripts/prepare-sidecar.mjs --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nova Download Manager",
        "width": 1240,
        "height": 780,
        "minWidth": 920,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Nova Download Manager",
    "category": "Utility",
    "shortDescription": "Gestionnaire de téléchargements",
    "longDescription": "Nova Download Manager accélère, organise et reprend vos téléchargements.",
    "copyright": "© 2026 Nova Download Manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "fr-FR"
      }
    },
    "externalBin": [
      "binaries/ndm-native-host"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3QTdFNDA5OTMwRkM2MDEKUldRQnhnK1RDZVNuZDB2enZOTXdHSUpCdjZYNVlxTDlnRG5TSDl6YTR2T2pLeFoxTGI5YiszT0sK",
      "endpoints": [
        "https://github.com/ysnoul17-afk/nova-download-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}